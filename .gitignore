# ─────────────────────────────────────────────────────────────────────────────
# .gitignore for the Pipetly submodule
# Covers Python development artefacts, secrets, and generated pipeline output.
# ─────────────────────────────────────────────────────────────────────────────

# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.py[codz]
*$py.class

# ── C extensions ──────────────────────────────────────────────────────────────
*.so

# ── Distribution / packaging ──────────────────────────────────────────────────
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual environments ───────────────────────────────────────────────────────
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
.envrc

# ── Pipetly generated output ──────────────────────────────────────────────────
output/
intermediate_outputs/

# ── Unit test / coverage reports ─────────────────────────────────────────────
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

# ── Jupyter / IPython ─────────────────────────────────────────────────────────
.ipynb_checkpoints
profile_default/
ipython_config.py

# ── Type checkers ─────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ── Linters / formatters ──────────────────────────────────────────────────────
.ruff_cache/

# ── Build / packaging tools ───────────────────────────────────────────────────
# pdm
.pdm-python
.pdm-build/
# pixi
.pixi
# PEP 582
__pypackages__/

# ── Installer logs ────────────────────────────────────────────────────────────
pip-log.txt
pip-delete-this-directory.txt

# ── Cython debug symbols ──────────────────────────────────────────────────────
cython_debug/

# ── Misc compiled / generated files ──────────────────────────────────────────
*.sage.py
*.manifest
*.spec
*.mo
*.pot
.abstra/
.pypirc
.pybuilder/
.pdm-build/
/site

# ── Editor / IDE ──────────────────────────────────────────────────────────────
# Uncomment if you want to ignore VS Code workspace settings:
# .vscode/
.cursorignore
.cursorindexingignore
.ropeproject
.spyderproject
.spyproject
