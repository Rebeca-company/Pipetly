# ─────────────────────────────────────────────────────────────────────────────
# .gitignore for the Pipetly submodule
# Covers Python development artefacts, secrets, and generated pipeline output.
# ─────────────────────────────────────────────────────────────────────────────

# ── Python bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.py[codz]
*$py.class

# ── C extensions ──────────────────────────────────────────────────────────────
*.so

# ── Distribution / packaging ──────────────────────────────────────────────────
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ── Virtual environments ───────────────────────────────────────────────────────
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.envrc

# ── Pipetly generated output ──────────────────────────────────────────────────
output/
intermediate_outputs/
*.log

# ── Unit test / coverage reports ─────────────────────────────────────────────
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.cover
.hypothesis/
.pytest_cache/
cover/

# ── Jupyter / IPython ─────────────────────────────────────────────────────────
.ipynb_checkpoints
profile_default/
ipython_config.py
notebooks/old/

# ── Type checkers ─────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ── Linters / formatters ──────────────────────────────────────────────────────
.ruff_cache/

# ── Build / packaging tools ───────────────────────────────────────────────────
# pdm
.pdm-python
.pdm-build/
# pixi
.pixi
# PEP 582
__pypackages__/

# ── Installer logs ────────────────────────────────────────────────────────────
pip-log.txt
pip-delete-this-directory.txt

# ── Cython debug symbols ──────────────────────────────────────────────────────
cython_debug/

# ── Misc compiled / generated files ──────────────────────────────────────────
*.sage.py
*.manifest
*.spec
*.mo
*.pot
.abstra/
.pypirc
.pybuilder/
/site

# ── Editor / IDE ──────────────────────────────────────────────────────────────
.vscode/
.cursorignore
.cursorindexingignore
.ropeproject
.spyderproject
.spyproject

# ── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Evaluation output ─────────────────────────────────────────────────────────
# OpenRouter activity CSVs (contain private account data, never commit)
openrouter_activity_*.csv
evaluation/openrouter_activity_*.csv

# Intermediate pipeline step files inside benchmark runs.
# These are large (up to ~65 MB per run) and fully reproducible.
# To regenerate: run  python evaluation/scripts/run_evaluations.py
# Individual files: step1_expanded_query.json … step8_scored_protocols.json
evaluation/runs/*/intermediate_steps/
evaluation/runs/*/telemetry/

# Judge output — timestamped JSON + Markdown reports, reproducible via llm_judge.py
evaluation/results/

# One-shot reorganisation helper (already executed, kept for reference only)
evaluation/_reorg.py
