# Pipetly – Environment variables
# Copy this file to .env and fill in your secrets.

# ── LLM (Required) ────────────────────────────────────────────────────────────
# Your OpenRouter API key  (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── External APIs (Optional, leave blank to skip that source) ─────────────────
# Elsevier / ScienceDirect  (https://dev.elsevier.com/)
ELSEVIER_API_KEY=
ELSEVIER_INST_TOKEN=

# Semantic Scholar – higher rate limits with a key (https://www.semanticscholar.org/product/api)
SEMANTIC_SCHOLAR_API_KEY=

# Unpaywall – requires a contact email to access the API (https://unpaywall.org/products/api)
UNPAYWALL_EMAIL=

# NCBI (PubMed/PMC) – requires an API key for higher rate limits (https://www.ncbi.nlm.nih.gov/account/)
NCBI_API_KEY=
