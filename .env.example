# Pipetly – Required environment variables
# Copy this file to .env and fill in your secrets.

# ── Required ──────────────────────────────────────────────────────────────────
# Your OpenRouter API key  (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Model override (optional) ─────────────────────────────────────────────────
# Gemini 1.5 Flash has been retired. Default is google/gemini-2.5-flash.
# Other options: google/gemini-2.0-flash-001, google/gemini-2.5-flash-lite
# GEMINI_MODEL=google/gemini-2.5-flash

# ── Optional (leave blank to skip that source) ────────────────────────────────
# Elsevier / ScienceDirect  (https://dev.elsevier.com/)
ELSEVIER_API_KEY=

# Semantic Scholar – higher rate limits with a key (https://www.semanticscholar.org/product/api)
SEMANTIC_SCHOLAR_API_KEY=
